<mujoco model="ur10e_rg2_workcell">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast">
    <flag contact="enable"/>
  </option>

  <default>
    <!-- UR-10e Defaults matching DeepMind Menagerie -->
    <default class="ur10e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>
      <position ctrlrange="-6.2831 6.2831"/>
      <general biastype="affine" ctrlrange="-6.2831 6.2831" gainprm="5000" biasprm="0 -5000 -500"/>
      <default class="size4">
        <joint damping="10"/>
        <general forcerange="-330 330"/>
      </default>
      <default class="size3">
        <joint damping="5"/>
        <general forcerange="-150 150"/>
        <default class="size3_limited">
          <joint range="-3.1415 3.1415"/>
          <general ctrlrange="-3.1415 3.1415"/>
        </default>
      </default>
      <default class="size2">
        <joint damping="2"/>
        <general forcerange="-56 56"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>

    <!-- OnRobot RG-2 Defaults -->
    <default class="rg2">
      <geom group="2" contype="0" conaffinity="0"/>
      <joint damping="0.5" armature="0.01" axis="0 0 1"/>
    </default>
    <default class="rg2_col">
      <geom group="3" contype="1" conaffinity="1" friction="1.8 0.05 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    </default>

    <!-- Surgical Tools Defaults -->
    <default class="tool">
      <geom friction="1.8 0.02 0.001" solref="0.005 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <asset>
    <!-- UR10e Meshes -->
    <mesh file="ur10e/assets/base_0.obj" name="base_0"/>
    <mesh file="ur10e/assets/base_1.obj" name="base_1"/>
    <mesh file="ur10e/assets/shoulder_0.obj" name="shoulder_0"/>
    <mesh file="ur10e/assets/shoulder_1.obj" name="shoulder_1"/>
    <mesh file="ur10e/assets/shoulder_2.obj" name="shoulder_2"/>
    <mesh file="ur10e/assets/upperarm_0.obj" name="upperarm_0"/>
    <mesh file="ur10e/assets/upperarm_1.obj" name="upperarm_1"/>
    <mesh file="ur10e/assets/upperarm_2.obj" name="upperarm_2"/>
    <mesh file="ur10e/assets/upperarm_3.obj" name="upperarm_3"/>
    <mesh file="ur10e/assets/forearm_0.obj" name="forearm_0"/>
    <mesh file="ur10e/assets/forearm_1.obj" name="forearm_1"/>
    <mesh file="ur10e/assets/forearm_2.obj" name="forearm_2"/>
    <mesh file="ur10e/assets/forearm_3.obj" name="forearm_3"/>
    <mesh file="ur10e/assets/wrist1_0.obj" name="wrist1_0"/>
    <mesh file="ur10e/assets/wrist1_1.obj" name="wrist1_1"/>
    <mesh file="ur10e/assets/wrist1_2.obj" name="wrist1_2"/>
    <mesh file="ur10e/assets/wrist2_0.obj" name="wrist2_0"/>
    <mesh file="ur10e/assets/wrist2_1.obj" name="wrist2_1"/>
    <mesh file="ur10e/assets/wrist2_2.obj" name="wrist2_2"/>
    <mesh file="ur10e/assets/wrist3.obj" name="wrist3"/>

    <!-- RG-2 Meshes from ekorudiawan/rg2_simulation -->
    <mesh file="rg2/assets/RG2_Hand_vis.STL" name="hand_vis"/>
    <mesh file="rg2/assets/RG2_Hand_col.STL" name="hand_col"/>
    <mesh file="rg2/assets/RG2_LeftMomentArm_vis.STL" name="l_moment_vis"/>
    <mesh file="rg2/assets/RG2_LeftMomentArm_col.STL" name="l_moment_col"/>
    <mesh file="rg2/assets/RG2_LeftFinger_vis.STL" name="l_finger_vis"/>
    <mesh file="rg2/assets/RG2_LeftFinger_col.STL" name="l_finger_col"/>
    <mesh file="rg2/assets/RG2_LeftTrussArm_vis.STL" name="l_truss_vis"/>
    <mesh file="rg2/assets/RG2_LeftTrussArm_col.STL" name="l_truss_col"/>
    <mesh file="rg2/assets/RG2_RightMomentArm_vis.STL" name="r_moment_vis"/>
    <mesh file="rg2/assets/RG2_RightMomentArm_col.STL" name="r_moment_col"/>
    <mesh file="rg2/assets/RG2_RightFinger_vis.STL" name="r_finger_vis"/>
    <mesh file="rg2/assets/RG2_RightFinger_col.STL" name="r_finger_col"/>
    <mesh file="rg2/assets/RG2_RightTrussArm_vis.STL" name="r_truss_vis"/>
    <mesh file="rg2/assets/RG2_RightTrussArm_col.STL" name="r_truss_col"/>

    <!-- Materials -->
    <material class="ur10e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur10e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur10e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur10e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <material name="rg2_chassis" rgba="0.15 0.15 0.17 1" specular="0.4" shininess="0.3"/>
    <material name="rg2_aluminum" rgba="0.65 0.65 0.68 1" specular="0.6" shininess="0.5"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.82 0.84 0.86 1" specular="0.6" shininess="0.5"/>
    <material name="cart_legs" rgba="0.3 0.3 0.35 1" specular="0.6" shininess="0.5"/>
    <material name="tray_mat" rgba="0.75 0.78 0.82 1" specular="0.8" shininess="0.8"/>
    <material name="scalpel_handle_mat" rgba="0.2 0.4 0.8 1" specular="0.4" shininess="0.3"/>
    <material name="steel_mat" rgba="0.9 0.9 0.92 1" specular="0.9" shininess="0.9"/>
  </asset>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light pos="-1 1 2.5" dir="0.5 -0.5 -1" diffuse="0.5 0.5 0.5" directional="true"/>

    <!-- Floor Plane -->
    <geom name="floor" type="plane" size="5 5 0.05" material="groundplane"/>

    <!-- Surgical Instrument Trolley / Cart standing at tray_pose reach -->
    <body name="instrument_trolley" pos="-0.58 0.065 0.0">
      <geom type="box" size="0.20 0.16 0.01" pos="0 0 0.065" material="table_mat"/>
      <geom type="cylinder" size="0.015 0.03" pos="-0.16 -0.12 0.03" material="cart_legs"/>
      <geom type="cylinder" size="0.015 0.03" pos="0.16 -0.12 0.03" material="cart_legs"/>
      <geom type="cylinder" size="0.015 0.03" pos="-0.16 0.12 0.03" material="cart_legs"/>
      <geom type="cylinder" size="0.015 0.03" pos="0.16 0.12 0.03" material="cart_legs"/>

      <!-- Surgical Tray on trolley -->
      <geom type="box" size="0.16 0.12 0.005" pos="0 0 0.075" material="tray_mat"/>
      <geom type="box" size="0.16 0.005 0.012" pos="0 0.115 0.082" material="tray_mat"/>
      <geom type="box" size="0.16 0.005 0.012" pos="0 -0.115 0.082" material="tray_mat"/>
      <geom type="box" size="0.005 0.12 0.012" pos="0.155 0 0.082" material="tray_mat"/>
      <geom type="box" size="0.005 0.12 0.012" pos="-0.155 0 0.082" material="tray_mat"/>
    </body>

    <!-- Scalpel in tray -->
    <body name="scalpel" pos="-0.58 0.045 0.095">
      <freejoint name="scalpel_joint"/>
      <geom class="tool" name="scalpel_handle" type="cylinder" size="0.006 0.055" pos="0 -0.02 0" quat="0.707 0.707 0 0" material="scalpel_handle_mat" mass="0.05"/>
      <geom class="tool" name="scalpel_blade" type="box" size="0.001 0.02 0.008" pos="0 0.045 0" material="steel_mat" mass="0.01"/>
    </body>

    <!-- Overview Camera View -->
    <camera name="overview_cam" pos="1.6 -1.3 1.3" xyaxes="0.63 0.77 0 -0.38 0.31 0.87"/>

    <!-- ============================================================== -->
    <!-- CANONICAL DEEPMIND MENAGERIE UR-10e ROBOT                      -->
    <!-- ============================================================== -->
    <body name="base" quat="0 0 0 -1" childclass="ur10e">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.0061063308908 0.0061063308908 0.01125"/>
      <geom mesh="base_0" material="black" class="visual"/>
      <geom mesh="base_1" material="jointgray" class="visual"/>

      <body name="shoulder_link" pos="0 0 0.181">
        <inertial pos="0 0 0" mass="7.778" diaginertia="0.0314743 0.0314743 0.0218756"/>
        <joint name="shoulder_pan_joint" class="size4" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.078 0.05" pos="0 0 -0.02"/>

        <body name="upper_arm_link" pos="0 0.176 0" quat="1 0 1 0">
          <inertial pos="0 0 0.3065" mass="12.93" diaginertia="0.423074 0.423074 0.0363656"/>
          <joint name="shoulder_lift_joint" class="size4"/>
          <geom mesh="upperarm_0" material="black" class="visual"/>
          <geom mesh="upperarm_1" material="jointgray" class="visual"/>
          <geom mesh="upperarm_2" material="urblue" class="visual"/>
          <geom mesh="upperarm_3" material="linkgray" class="visual"/>
          <geom class="collision" pos="0 -0.05 0" quat="1 1 0 0" size="0.078 0.08"/>
          <geom class="collision" size="0.06 0.3" pos="0 0 0.3"/>

          <body name="forearm_link" pos="0 -0.137 0.613">
            <inertial pos="0 0 0.2855" mass="3.87" diaginertia="0.11059 0.11059 0.0108844"/>
            <joint name="elbow_joint" class="size3_limited"/>
            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="black" class="visual"/>
            <geom mesh="forearm_2" material="jointgray" class="visual"/>
            <geom mesh="forearm_3" material="linkgray" class="visual"/>
            <geom class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.058 0.065"/>
            <geom class="collision" size="0.043 0.28" pos="0 0 0.29"/>

            <body name="wrist_1_link" pos="0 0 0.571" quat="1 0 1 0">
              <inertial pos="0 0.135 0" quat="0.5 0.5 -0.5 0.5" mass="1.96" diaginertia="0.0055125 0.00510825 0.00510825"/>
              <joint name="wrist_1_joint" class="size2"/>
              <geom mesh="wrist1_0" material="black" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="jointgray" class="visual"/>
              <geom class="collision" pos="0 0.06 0" quat="1 1 0 0" size="0.05 0.07"/>

              <body name="wrist_2_link" pos="0 0.135 0">
                <inertial pos="0 0 0.12" quat="0.5 0.5 -0.5 0.5" mass="1.96" diaginertia="0.0055125 0.00510825 0.00510825"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size2"/>
                <geom mesh="wrist2_0" material="black" class="visual"/>
                <geom mesh="wrist2_1" material="urblue" class="visual"/>
                <geom mesh="wrist2_2" material="jointgray" class="visual"/>
                <geom class="collision" size="0.046 0.065" pos="0 0 0.05"/>
                <geom class="collision" pos="0 0.028 0.12" quat="1 1 0 0" size="0.046 0.043"/>

                <body name="wrist_3_link" pos="0 0 0.12">
                  <inertial pos="0 0.092 0" quat="0 1 -1 0" mass="0.202" diaginertia="0.000204525 0.000144346 0.000144346"/>
                  <joint name="wrist_3_joint" class="size2"/>
                  <geom material="linkgray" mesh="wrist3" class="visual"/>
                  <geom class="eef_collision" pos="0 0.097 0" quat="1 1 0 0" size="0.046 0.02"/>

                  <!-- ============================================== -->
                  <!-- AUTHENTIC ONROBOT RG-2 GRIPPER CAD ASSEMBLY    -->
                  <!-- ============================================== -->
                  <body name="hand_link" pos="0 0.092 0" quat="0.7071 0 0 0.7071" childclass="rg2">
                    <inertial mass="1.68" pos="0.06 0 0" diaginertia="0.00086 0.0024 0.0026"/>
                    <geom type="mesh" mesh="hand_vis" material="rg2_chassis"/>
                    <geom class="rg2_col" type="mesh" mesh="hand_col"/>

                    <!-- Left Moment Arm -->
                    <body name="l_moment_arm_link" pos="0.105 0.017 0.010">
                      <inertial mass="0.16" pos="0.017 -0.006 0" diaginertia="0.000023 0.000072 0.000083"/>
                      <joint name="gripper_joint" range="-0.45 0.9"/>
                      <geom type="mesh" mesh="l_moment_vis" material="rg2_aluminum"/>
                      <geom class="rg2_col" type="mesh" mesh="l_moment_col"/>

                      <body name="l_finger_link" pos="0.049 0.026 0.000">
                        <inertial mass="0.08" pos="0.025 -0.01 0" diaginertia="0.000006 0.000025 0.000026"/>
                        <joint name="l_finger_2_joint" range="-0.9 0.45"/>
                        <geom type="mesh" mesh="l_finger_vis" material="rg2_aluminum"/>
                        <geom class="rg2_col" type="mesh" mesh="l_finger_col"/>
                      </body>
                    </body>

                    <!-- Left Truss Arm -->
                    <body name="l_truss_arm_link" pos="0.122 0.008 0.010">
                      <inertial mass="0.066" pos="0.023 0.012 0" diaginertia="0.000010 0.000024 0.000025"/>
                      <joint name="l_finger_passive_joint" range="-0.45 0.9"/>
                      <geom type="mesh" mesh="l_truss_vis" material="rg2_aluminum"/>
                      <geom class="rg2_col" type="mesh" mesh="l_truss_col"/>
                    </body>

                    <!-- Right Moment Arm -->
                    <body name="r_moment_arm_link" pos="0.105 -0.017 0.010">
                      <inertial mass="0.16" pos="0.017 0.006 0" diaginertia="0.000023 0.000072 0.000083"/>
                      <joint name="r_finger_1_joint" range="-0.9 0.45"/>
                      <geom type="mesh" mesh="r_moment_vis" material="rg2_aluminum"/>
                      <geom class="rg2_col" type="mesh" mesh="r_moment_col"/>

                      <body name="r_finger_link" pos="0.049 -0.026 0.000">
                        <inertial mass="0.08" pos="0.025 0.01 0" diaginertia="0.000006 0.000025 0.000026"/>
                        <joint name="r_finger_2_joint" range="-0.45 0.9"/>
                        <geom type="mesh" mesh="r_finger_vis" material="rg2_aluminum"/>
                        <geom class="rg2_col" type="mesh" mesh="r_finger_col"/>
                      </body>
                    </body>

                    <!-- Right Truss Arm -->
                    <body name="r_truss_arm_link" pos="0.122 -0.008 0.010">
                      <inertial mass="0.066" pos="0.023 -0.012 0" diaginertia="0.000010 0.000024 0.000025"/>
                      <joint name="r_finger_passive_joint" range="-0.9 0.45"/>
                      <geom type="mesh" mesh="r_truss_vis" material="rg2_aluminum"/>
                      <geom class="rg2_col" type="mesh" mesh="r_truss_col"/>
                    </body>

                    <!-- Gripper TCP Site -->
                    <site name="rg2_tcp" pos="0.20 0 0.01" size="0.008" rgba="1 0.2 0.2 0.8"/>
                  </body>
                  <!-- End of RG-2 Gripper Assembly -->

                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <!-- Symmetrical 4-bar linkage coupling mimicking real RG-2 mechanism -->
    <joint joint1="gripper_joint" joint2="l_finger_2_joint" polycoef="0 -1 0 0 0"/>
    <joint joint1="gripper_joint" joint2="r_finger_1_joint" polycoef="0 -1 0 0 0"/>
    <joint joint1="gripper_joint" joint2="r_finger_2_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="gripper_joint" joint2="l_finger_passive_joint" polycoef="0 1 0 0 0"/>
    <joint joint1="gripper_joint" joint2="r_finger_passive_joint" polycoef="0 -1 0 0 0"/>
  </equality>

  <contact>
    <exclude body1="wrist_3_link" body2="hand_link"/>
    <exclude body1="hand_link" body2="l_moment_arm_link"/>
    <exclude body1="hand_link" body2="l_truss_arm_link"/>
    <exclude body1="hand_link" body2="r_moment_arm_link"/>
    <exclude body1="hand_link" body2="r_truss_arm_link"/>
    <exclude body1="l_moment_arm_link" body2="l_truss_arm_link"/>
    <exclude body1="l_moment_arm_link" body2="l_finger_link"/>
    <exclude body1="l_moment_arm_link" body2="r_moment_arm_link"/>
    <exclude body1="l_finger_link" body2="l_truss_arm_link"/>
    <exclude body1="r_moment_arm_link" body2="r_truss_arm_link"/>
    <exclude body1="r_moment_arm_link" body2="r_finger_link"/>
    <exclude body1="r_finger_link" body2="r_truss_arm_link"/>
  </contact>

  <actuator>
    <!-- UR-10e Joint Actuators -->
    <general class="size4" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="size4" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="size3_limited" name="elbow" joint="elbow_joint"/>
    <general class="size2" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size2" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size2" name="wrist_3" joint="wrist_3_joint"/>

    <!-- RG-2 Gripper Actuator (Controls parallelogram linkage) -->
    <position name="rg2_actuator" joint="gripper_joint" ctrlrange="-0.45 0.8" kp="60" kv="6" forcerange="-40 40"/>
  </actuator>
</mujoco>
